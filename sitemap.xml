---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign excluded_urls = "/robots.txt,/featured-images,/subscribe-thanks/,/trainings/,/category,/talks-archive/,/subscribe/,/404,/404.html" | split: "," %}
{% assign entries = site.pages | concat: site.posts | concat: site.people | concat: site.talks %}

{% for entry in entries %}
  {% assign entry_url = entry.url | replace: 'index.html', '' %}
  {% if entry.sitemap == false %}
    {% continue %}
  {% endif %}
  {% if excluded_urls contains entry_url %}
    {% continue %}
  {% endif %}
  {% if entry_url contains 'assets' or entry_url contains '.xml' %}
    {% continue %}
  {% endif %}
  <url>
    <loc>{{ entry_url | absolute_url | xml_escape }}</loc>
    {% if entry.last_modified_at %}
    <lastmod>{{ entry.last_modified_at | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
{% endfor %}
</urlset>